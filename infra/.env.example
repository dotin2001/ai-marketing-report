# Copy to infra/.env, replace every CHANGE_ME value, and keep the real file local.
# Consumed by Docker Compose for the project-scoped development dependency stack.

# PostgreSQL database identity and loopback host port.
POSTGRES_DB=marketing_reports
POSTGRES_USER=marketing_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# Authenticated Redis password and loopback host port.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# SeaweedFS S3 identity, private bucket, region label, and loopback host ports.
S3_ACCESS_KEY_ID=CHANGE_ME_SEAWEEDFS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_SEAWEEDFS_SECRET_KEY
S3_BUCKET=marketing-reports-local
S3_REGION=us-east-1
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
