# Copy to frontend/.env.local. These settings are browser-visible.
# Use an absolute HTTP(S) URL with no credentials, query string, or fragment.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Match the backend's effective SOURCE_CSV_MAX_BYTES and SOURCE_TEXT_MAX_BYTES.
NEXT_PUBLIC_SOURCE_CSV_MAX_BYTES=10485760
NEXT_PUBLIC_SOURCE_TEXT_MAX_BYTES=1048576

