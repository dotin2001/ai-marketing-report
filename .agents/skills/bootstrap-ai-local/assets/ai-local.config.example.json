{
  "github": {
    "repository": "example-owner/example-repository",
    "projectOwner": "example-owner",
    "projectNumber": 1,
    "statusField": "Status",
    "todoOption": "Todo",
    "inProgressOption": "In Progress",
    "doneOption": "Done"
  },
  "packageManager": "npm",
  "verification": {
    "autoDiscover": true,
    "syncTask": {
      "requiredCommands": ["git diff --check", "npm run frontend:test", "npm run backend:test"],
      "semanticReview": "optional"
    },
    "approvedPostgresHosts": ["localhost", "127.0.0.1", "::1"],
    "executionProfiles": {
      "backend:check": "backend-test",
      "database:check": "postgresql"
    },
    "commands": [
      {
        "command": "npm",
        "args": ["test"],
        "timeoutMs": 300000,
        "executionProfile": "neutral"
      }
    ]
  },
  "runtimeDirectory": ".ai-local"
}
