# Copy to backend/.env, replace every CHANGE_ME value, and keep the real file local.
# The backend rejects placeholders and unknown keys before serving requests.

# Application process settings.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
LOG_LEVEL=INFO

# PostgreSQL identity plus the credential-bearing async SQLAlchemy URL.
POSTGRES_DB=marketing_reports
POSTGRES_USER=marketing_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://marketing_app:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/marketing_reports

# Server-only migration and disposable integration-test URLs. These are deliberately
# not loaded by the web application's Settings model.
MIGRATION_DATABASE_URL=postgresql+psycopg://marketing_app:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/marketing_reports
TEST_DATABASE_URL=postgresql+psycopg://marketing_app:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/marketing_reports_test

# Redis authentication plus the credential-bearing async client URL.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

# S3-compatible object storage used only for a read-only bucket readiness probe.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME_SEAWEEDFS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_SEAWEEDFS_SECRET_KEY
S3_BUCKET=marketing-reports-local
S3_USE_SSL=false
